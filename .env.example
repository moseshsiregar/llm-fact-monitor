# Copy this file to `.env.local` and fill in the keys you have access to.
# `.env.local` is gitignored - NEVER commit real API keys.
#
# Missing keys are handled gracefully: that provider will show as
# "Not configured" on the New Experiment page and cannot be selected for a
# REAL experiment run. The app will never silently substitute a mock
# provider for a missing real one.

# Direct-SDK keys below are preserved for the standalone `openai-direct-sdk`
# comparison adapter and dev smoke tests only. They are NOT used by live
# experiment execution - the production research path routes every live
# provider call through OpenRouter (see OPENROUTER_API_KEY below).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar-pro

# OpenRouter - the unified access layer for ALL live experiment execution.
# One key powers all four logical providers (OpenAI/Gemini/Claude/Perplexity)
# shown on the New Experiment page. Without this key, live execution is
# disabled entirely for all four - never silently replaced with mock data.
OPENROUTER_API_KEY=

# Per-family model overrides (all optional - each defaults to the model ID
# validated via live smoke test if unset).
OPENROUTER_OPENAI_MODEL=openai/gpt-4.1
OPENROUTER_GEMINI_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_CLAUDE_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_PERPLEXITY_MODEL=perplexity/sonar

# Max number of live provider calls in flight at once during an experiment
# run (optional, defaults to 2).
MAX_CONCURRENT_EXPERIMENT_RUNS=2

# Phase 8 - max number of semantic FactVerifier calls in flight at once
# while checking one provider answer against its candidate facts (optional,
# defaults to 3, clamped to the 2-4 range). Deliberately conservative -
# never send hundreds of verifier calls simultaneously.
VERIFIER_CONCURRENCY=3

# Phase 8 - overrides the model used by the semantic FactVerifier (optional,
# defaults to the verified-working model in openRouterFactVerifier.ts).
OPENROUTER_VERIFIER_MODEL=

# Phase 8 - request timeout (ms) for a single semantic verifier call before
# it is classified as a retryable TIMEOUT (optional, defaults to 30000).
VERIFIER_TIMEOUT_MS=30000

